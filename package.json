{
  "name": "vic-mol.github.io",
  "private": true,
  "description": "Victor Molina's bilingual portfolio (Hugo + CareerCanvas)",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "hugo server --disableFastRender",
    "build": "hugo build --gc --minify",
    "check": "node scripts/check-site.mjs public",
    "vendor": "node scripts/vendor.mjs",
    "test": "npm run build && npm run check"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@fullhuman/postcss-purgecss": "8.0.0",
    "@tailwindcss/typography": "0.5.20",
    "autoprefixer": "10.6.1",
    "cheerio": "1.2.0",
    "postcss": "8.5.31",
    "postcss-cli": "12.0.0",
    "postcss-import": "17.0.1",
    "tailwindcss": "3.4.19"
  }
}
